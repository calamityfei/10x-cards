---
import ProtectedLayout from "@/layouts/ProtectedLayout.astro";
import StudySessionComponent from "@/components/StudySession";

export const prerender = false;

if (!Astro.locals.user) {
  return Astro.redirect("/login");
}
---

<ProtectedLayout title="Study Session">
  <StudySessionComponent client:load />
</ProtectedLayout>
